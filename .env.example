# Lấy API key miễn phí tại https://aistudio.google.com/apikey
GEMINI_API_KEY=dan_api_key_cua_ban_vao_day

# Model Gemini dùng để phân tích ghi chú (có thể đổi sang bản mới hơn nếu Google ra mắt)
GEMINI_MODEL=gemini-2.5-flash

# Cổng chạy server (Render/Railway sẽ tự set biến PORT, không cần sửa)
PORT=3000
